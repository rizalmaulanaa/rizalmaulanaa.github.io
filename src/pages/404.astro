---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <div class="wrap">
    <div class="card lost c-pink">
      <span class="label">Error</span>
      <h1>404</h1>
      <p>This card isn't in the deck.</p>
      <a class="btn dark c-lime" href="/">Back to the deck →</a>
    </div>
  </div>
</Base>
